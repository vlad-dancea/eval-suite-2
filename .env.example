# Copy this file to .env and fill in local-only values.
# .env is ignored by Git; do not commit real API keys.

AQUEDUCT_API_KEY=replace-with-your-aqueduct-key
AQUEDUCT_MAIN_MODEL=replace-with-main-model-id

# Optional. If omitted, the backend uses AQUEDUCT_MAIN_MODEL as the judge model too.
AQUEDUCT_JUDGE_MODEL=
